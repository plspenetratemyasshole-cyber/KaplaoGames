# Kaplao account website
#
# Local:
#   npm install
#   npm run dev
# Open http://localhost:3000

NEXT_PUBLIC_APP_NAME=Kaplao Games
# Public site URL (emails / links). Production: https://kaplao.ru
NEXT_PUBLIC_APP_URL=https://kaplao.ru
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret for Unity -> /api/game/verify-player and /api/levels/upload-url
GAME_SERVER_SECRET=change-me-to-another-long-random-string
DATA_DIR=./data

# Resend — email verification + password reset codes
RESEND_API_KEY=
# After domain is verified in Resend, use e.g. Kaplao <noreply@kaplao.ru>
EMAIL_FROM=Kaplao <onboarding@resend.dev>

# Supabase (required on Vercel) — account DB
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase LEVELS project — public level catalog metadata (table `levels`)
LEVELS_SUPABASE_URL=
LEVELS_SUPABASE_SERVICE_ROLE_KEY=

# Timeweb Cloud S3 — level zip files (/api/levels/download, /api/levels/upload-url)
TIMEWEB_S3_ENDPOINT=https://s3.twcstorage.ru
TIMEWEB_S3_REGION=ru-1
TIMEWEB_S3_BUCKET=kaplao-levels
TIMEWEB_S3_ACCESS_KEY=
TIMEWEB_S3_SECRET_KEY=
