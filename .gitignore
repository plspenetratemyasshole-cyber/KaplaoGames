# ==============================================================================
# Unity Ignore Rules
# ==============================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta check
[Aa]ssets/[Aa]ssetStoreTools*

# Autogenerated JetBrains Rider / Visual Studio / VS Code cache & solutions
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Android / Native artifacts & crash reports
.utmp/
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# ==============================================================================
# Heavy Game Assets & TMPro Fonts (Exceeding GitHub 100MB limit)
# ==============================================================================
# TextMesh Pro generated font assets (huge ~128MB SDF / Atlas textures)
/[Aa]ssets/[Ff]onts/*.asset
/[Aa]ssets/[Ff]onts/*.asset.meta
/[Aa]ssets/[Ff]onts/**/*.asset
/[Aa]ssets/[Ff]onts/**/*.asset.meta

# Minecraft Sounds (StreamingAssets)
/[Aa]ssets/[Ss]treaming[Aa]ssets/MinecraftSounds/
/[Aa]ssets/[Ss]treaming[Aa]ssets/MinecraftSounds.meta
**/MinecraftSounds/
**/MinecraftSounds.meta

# Block Textures
/[Aa]ssets/BlockTextures/
/[Aa]ssets/BlockTextures.meta
**/BlockTextures/
**/BlockTextures.meta

# ==============================================================================
# Website (KaplaoGamesWebsite / Next.js / Node / Supabase / Workers)
# ==============================================================================
# Dependencies
node_modules/
KaplaoGamesWebsite/node_modules/

# Next.js build output & cache
.next/
KaplaoGamesWebsite/.next/
out/
KaplaoGamesWebsite/out/
.turbo/

# Vercel deployment cache
.vercel/
KaplaoGamesWebsite/.vercel/

# TypeScript build info
*.tsbuildinfo
KaplaoGamesWebsite/tsconfig.tsbuildinfo

# Website data & local database dumps
KaplaoGamesWebsite/data/
data/

# Supabase CLI temporary files
**/.temp/
KaplaoGamesWebsite/supabase/.temp/

# Cloudflare Workers cache
.wrangler/

# Environment files (keep example configs tracked)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
KaplaoGamesWebsite/.env
KaplaoGamesWebsite/.env*.local
KaplaoGamesWebsite/.env.local
!.env.example
!KaplaoGamesWebsite/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

